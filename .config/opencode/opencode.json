{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "model": "anthropic/claude-opus-5-5",
  "plugins": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "instructions": ["~/projects/personal/AGENTS.md"],
  "skills": [
    "~/.pi/agent/git/github.com/addyosmani/agent-skills/skills",
    "~/.omp/plugins/node_modules/ecc-universal/skills"
  ],
  "agents": {
    "build": { "model": "claude-agent/claude-opus-5-5#xhigh" },
    "plan": { "model": "claude-agent/claude-opus-5-5#xhigh" },
    "general": { "model": "openai/gpt-6.2-sol" },
    "explore": { "model": "claude-agent/claude-haiku-5-5" },
    "title": { "model": "claude-agent/claude-haiku-5-5" }
  },
  "mini": {
    "tools": "show",
    "shell_output": "show"
  },
  "mcp": {
    "servers": {
      "notion": { "type": "remote", "url": "https://mcp.notion.com/mcp" },
      "linear": { "type": "remote", "url": "https://mcp.linear.app/mcp" },
      "artifacts": { "type": "remote", "url": "https://artifacts.m64.sh/mcp" },
      "pensieve": {
        "type": "remote",
        "url": "https://pensieve.tailb3334f.ts.net/mcp",
        "headers": { "X-Pensieve-Agent": "opencode" }
      }
    }
  }
}
