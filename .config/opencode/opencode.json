{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "model": "anthropic/claude-opus-5-5",
  "plugins": ["opencode-claude-auth"],
  "instructions": ["~/projects/personal/AGENTS.md"],
  "skills": [
    "~/.omp/agent/skills",
    "~/.pi/agent/git/github.com/addyosmani/agent-skills/skills"
  ],
  "agents": {
    "build": { "model": "anthropic/claude-opus-5-5#xhigh" },
    "plan": { "model": "anthropic/claude-opus-5-5#xhigh" },
    "general": { "model": "openai/gpt-6.2-sol" },
    "explore": { "model": "anthropic/claude-haiku-5-5" },
    "title": { "model": "anthropic/claude-haiku-5-5" }
  },
  "mcp": {
    "servers": {
      "notion": { "type": "remote", "url": "https://mcp.notion.com/mcp" },
      "linear": { "type": "remote", "url": "https://mcp.linear.app/mcp" },
      "artifacts": { "type": "remote", "url": "https://artifacts.m64.sh/mcp" },
      "parallel-search": { "type": "remote", "url": "https://search.parallel.ai/mcp" },
      "pensieve": {
        "type": "remote",
        "url": "https://pensieve.tailb3334f.ts.net/mcp",
        "headers": { "X-Pensieve-Agent": "opencode" }
      }
    }
  }
}
